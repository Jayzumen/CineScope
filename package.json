{
  "name": "cinescope",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint src tests --max-warnings=0",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-cinescope \"node --experimental-strip-types --test tests/firestore/*.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:auth": "node scripts/auth-e2e-runner.mjs",
    "test:performance": "playwright test --config playwright.performance.config.ts",
    "test:redis": "node --experimental-strip-types --test tests/integration/redis.test.mjs",
    "check:deployment": "node scripts/check-deployment.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "firebase": "^13.3.0",
    "jose": "^6.2.17",
    "lucide-react": "^1.73.0",
    "next": "^16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "eslint-config-next": "16.4.6",
    "firebase-tools": "^15.36.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3"
  },
  "pnpm": {
    "overrides": {
      "@firebase/firestore>@grpc/grpc-js": "^1.14.7"
    }
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@10.12.4"
}
