# Copy to .env.local. Never commit secrets. Public values are embedded at build time.
SITE_URL="http://localhost:3000"
# Preferred: TMDB v4 "API Read Access Token" (sent as a header, never in URLs).
TMDB_READ_ACCESS_TOKEN=""
# Fallback: v3 API key, only used when the read access token is empty.
TMDB_API_KEY=""
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
# Development test switch only. Never enable this in a production build.
NEXT_PUBLIC_FIREBASE_EMULATORS=""
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
# Hostname only, no scheme/port/path. Register each deployment domain with Turnstile.
TURNSTILE_HOSTNAME=""
# Required at production runtime. All instances share these credentials/namespace.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
RATE_LIMIT_NAMESPACE="cinescope"
# Netlify candidate: x-nf-client-connection-ip. Verify proxy overwrite before setting.
TRUSTED_CLIENT_IP_HEADER=""
# Request header with the visitor's country, used only as the default watch
# region. Netlify's proxy sets x-country (the default when this is empty).
GEO_COUNTRY_HEADER=""
TMDB_GLOBAL_RATE_LIMIT_PER_MINUTE="120"
TMDB_GLOBAL_RATE_LIMIT_PER_HOUR="3000"
SEARCH_RATE_LIMIT_PER_MINUTE="20"
SEARCH_RATE_LIMIT_PER_HOUR="300"
SEARCH_CHALLENGE_THRESHOLD="8"
BROWSE_RATE_LIMIT_PER_MINUTE="60"
BROWSE_RATE_LIMIT_PER_HOUR="600"
