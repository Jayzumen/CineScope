rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    // Legacy favorites. The app migrates these into the library as favorites,
    // so they may only be read and deleted; no new writes are accepted.
    match /users/{uid}/likedMovies/{id} {
      allow read, delete: if owner(uid);
    }
    match /users/{uid}/likedShows/{id} {
      allow read, delete: if owner(uid);
    }
    function validLibrary(id) {
      let d = request.resource.data;
      let fields = ['id','kind','title','poster_path','year','status','rating','favorite','addedAt','updatedAt'];
      return d.keys().hasAll(fields) && d.keys().hasOnly(fields)
        && d.id is int && d.id > 0 && d.id <= 9999999999
        && d.kind in ['movie','tv']
        && id == d.kind + '-' + string(d.id)
        && d.title is string && d.title.size() > 0 && d.title.size() <= 500
        && d.poster_path is string && d.poster_path.size() <= 200
        && (d.poster_path == '' || d.poster_path.matches('^/[a-zA-Z0-9._-]+$'))
        && d.year is string && (d.year == '' || d.year.matches('^[0-9]{4}$'))
        && d.status in ['','watchlist','watched']
        && d.favorite is bool
        // A document must hold something: a list status or a favorite.
        && (d.status != '' || d.favorite == true)
        && d.rating is int && d.rating >= 0 && d.rating <= 10
        && d.updatedAt == request.time;
    }
    match /users/{uid}/library/{id} {
      allow read, delete: if owner(uid);
      allow create: if owner(uid) && validLibrary(id)
        && request.resource.data.addedAt == request.time;
      // addedAt never changes. Documents from before timestamps existed get
      // their addedAt set to the time of their first update.
      allow update: if owner(uid) && validLibrary(id)
        && request.resource.data.addedAt == resource.data.get('addedAt', request.time);
    }
    // All other paths are denied implicitly, including user-profile writes.
  }
}
